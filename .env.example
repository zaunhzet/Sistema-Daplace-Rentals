# ==============================================================================
# DAPLACE RENTALS — Archivo de Ejemplo de Configuración (.env.example)
# NOTA: NUNCA colocar credenciales reales de producción en este archivo.
# ==============================================================================

# 1. Base de Datos de Aplicación (Usuario con privilegios mínimos, sin SUPERUSER)
DATABASE_URL="postgresql://daplace:daplace_local_only@localhost:5432/daplace_dev?schema=public"

# 2. Base de Datos de Pruebas Automatizadas (Aislamiento estricto: daplace_test en host local)
DATABASE_TEST_URL="postgresql://daplace:daplace_local_only@localhost:5432/daplace_test?schema=public"

# 3. Servidor Fastify (Debe escuchar exclusivamente en loopback para desarrollo seguro)
API_HOST="127.0.0.1"
API_PORT="3000"

# 4. Autorización y Modo Demostración Local
# ADVERTENCIA: En 'production', este bypass se rechaza automáticamente.
# Solo en desarrollo local y sobre loopback, si se fija en 'true', permite usar actor de prueba local.
ENABLE_DEMO_AUTH_BYPASS="false"

# 5. Configuración CORS (Lista separada por comas de orígenes frontend permitidos)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# 6. Frontend Vite
VITE_API_BASE_URL="http://127.0.0.1:3000"
# VITE_USE_MOCKS="true" # Descomentar únicamente si se requiere correr el frontend sin backend

# 7. Configuración Opcional para Inicialización de BD (backend/src/scripts/init-local-db.ts)
# PGHOST_ADMIN="127.0.0.1"
# PGPORT_ADMIN="5432"
# PGUSER_ADMIN="postgres"
# PGPASSWORD_ADMIN="postgres"
# PGDATABASE_ADMIN="postgres"
# DB_APP_USER="daplace"
# DB_APP_PASSWORD="daplace_local_only"

# 8. Seguridad Bancaria e Idempotencia DR-01 (Hash HMAC de Cuentas Bancarias)
# - Cuándo se requiere: Obligatorio si el backend procesa pagos donde se ingresa una cuenta bancaria completa
#   (no enmascarada). Si el cliente solo envía referencia enmascarada (ej. ****4444) o no envía cuenta, no se aplica HMAC.
# - Requisitos de configuración: Mínimo 32 bytes efectivos (cadena criptográficamente aleatoria). No se permiten cadenas vacías,
#   compuestas solo de espacios en blanco o de longitud menor a 32 bytes (no se corrigen silenciosamente con trim).
# - Variable principal: BANK_ACCOUNT_HMAC_SECRET.
# - Variable alias: PAYMENT_HMAC_SECRET (solo tiene precedencia si BANK_ACCOUNT_HMAC_SECRET no está definida).
#   Si la principal está definida pero es inválida, se rechaza inmediatamente con HTTP 500 (sin recurrir al alias).
# - Estabilidad: Debe mantenerse idéntica entre reinicios y despliegues del servicio.
# - Efecto de cambio: Cambiar la clave altera el HMAC de canonicalización; un reintento idempotente posterior no coincidirá
#   con el hash histórico almacenado, resultando en HTTP 409 (conflicto) para proteger la inmutabilidad financiera.
# - Comportamiento cuando falta/inválida: El endpoint rechaza la petición con HTTP 500 (MISSING_CONFIGURATION o INVALID_CONFIGURATION)
#   con exactamente cero escrituras en la base de datos (rechazo seguro antes de iniciar transacción de persistencia).
# - Distinción de cuenta: La cuenta completa se usa ÚNICAMENTE en memoria para derivar el HMAC en el payload canónico y
#   se enmascara inmediatamente (****1234) para auditoría y persistencia. La cuenta completa jamás se persiste ni se retorna en logs.
# BANK_ACCOUNT_HMAC_SECRET="ejemplo_de_clave_secreta_minimo_32_bytes_de_longitud_aleatoria"
# PAYMENT_HMAC_SECRET=""

# 9. Autenticación y Seguridad Web
# JWT_SECRET es obligatorio cuando la autenticación está activa y debe tener al menos 32 caracteres.
# Genere una clave criptográfica segura para su entorno local (ej. con openssl rand -base64 32).
JWT_SECRET="ejemplo_clave_insegura_generar_secreto_local_minimo_32_caracteres"
JWT_EXPIRES_IN="15m"

# Orígenes CORS autorizados (separados por coma). No se permite el comodín "*" con credenciales.
CORS_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"

# Cookie de refresh token: false para desarrollo local HTTP, true para producción con HTTPS
COOKIE_SECURE="false"

# Bootstrap de desarrollo local (exclusivo para base de datos local de desarrollo)
# Requiere autorización explícita para evitar ejecuciones accidentales contra bases no locales.
ALLOW_DEV_SEED="false"
DEV_DEFAULT_PASSWORD=""
