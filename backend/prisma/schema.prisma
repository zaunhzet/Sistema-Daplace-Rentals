generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  ADMIN
  OPERADOR
  PROPIETARIO
}

enum EstadoOperativo {
  OPERATIVA
  EN_MANTENIMIENTO
  INACTIVA
}

enum EstadoPublicacion {
  PUBLICADA
  BORRADOR
  PAUSADA
}

enum TipoDocumento {
  DNI
  PASAPORTE
  CARNET_EXTRANJERIA
  OTRO
}

enum EstadoReserva {
  SOLICITADA
  CONFIRMADA
  COMPLETADA
  CANCELADA
}

enum OrigenReserva {
  WEB
  DIRECTO
  AIRBNB
}

model Usuario {
  id            String       @id @default(uuid())
  nombre        String
  email         String       @unique
  telefono      String?
  rol           RolUsuario   @default(PROPIETARIO)
  activo        Boolean      @default(true)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt

  propiedades   Propiedad[]

  @@map("usuarios")
}

model Propiedad {
  id                 String            @id @default(uuid())
  nombre             String
  propietarioId      String
  direccion          String
  estadoOperativo    EstadoOperativo   @default(OPERATIVA)
  estadoPublicacion  EstadoPublicacion @default(BORRADOR)
  activa             Boolean           @default(true)
  capacidadHuespedes Int               @default(2)
  precioBaseNoche    Decimal           @default(200.00) @db.Decimal(10, 2)
  moneda             String            @default("PEN")
  creadoEn           DateTime          @default(now())
  actualizadoEn      DateTime          @updatedAt

  propietario        Usuario           @relation(fields: [propietarioId], references: [id], onDelete: Restrict)
  reservas           Reserva[]

  @@index([propietarioId])
  @@index([estadoOperativo, activa])
  @@map("propiedades")
}

model Huesped {
  id              String         @id @default(uuid())
  nombreCompleto  String
  telefono        String?
  email           String?
  tipoDocumento   TipoDocumento?
  numeroDocumento String?
  nacionalidad    String?
  notas           String?
  creadoEn        DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt

  reservas        Reserva[]

  @@index([email])
  @@index([telefono])
  @@index([numeroDocumento])
  @@map("huespedes")
}

model Reserva {
  id                String        @id @default(uuid())
  propiedadId       String
  huespedId         String
  ingreso           DateTime      @db.Date
  salida            DateTime      @db.Date
  noches            Int
  estado            EstadoReserva @default(SOLICITADA)
  montoAcordado     Decimal       @db.Decimal(10, 2)
  moneda            String        @default("PEN")
  origen            OrigenReserva @default(WEB)
  referenciaCanal   String?
  notas             String?
  motivoCancelacion String?
  creadaEn          DateTime      @default(now())
  actualizadaEn     DateTime      @updatedAt

  propiedad         Propiedad     @relation(fields: [propiedadId], references: [id], onDelete: Restrict)
  huesped           Huesped       @relation(fields: [huespedId], references: [id], onDelete: Restrict)

  @@index([propiedadId, ingreso, salida])
  @@index([huespedId])
  @@index([estado])
  @@map("reservas")
}

model AuditoriaEvento {
  id         String   @id @default(uuid())
  entidad    String
  entidadId  String
  accion     String
  actor      String   @default("SYSTEM_DEV")
  motivo     String?
  detalles   Json?
  requestId  String?
  creadoEn   DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([creadoEn])
  @@map("auditoria_eventos")
}
