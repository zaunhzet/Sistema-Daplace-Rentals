generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  ADMIN
  OPERADOR
  PROPIETARIO
}

enum EstadoOperativo {
  OPERATIVA
  EN_MANTENIMIENTO
  INACTIVA
}

enum EstadoPublicacion {
  PUBLICADA
  BORRADOR
  PAUSADA
}

enum TipoDocumento {
  DNI
  PASAPORTE
  CARNET_EXTRANJERIA
  OTRO
}

enum EstadoReserva {
  SOLICITADA
  CONFIRMADA
  COMPLETADA
  CANCELADA
  EXPIRADA
}

enum OrigenReserva {
  WEB
  DIRECTO
  AIRBNB
}

enum EstadoPago {
  PENDIENTE_CONCILIACION
  CONCILIADO
  RECHAZADO
}

enum BeneficiarioPago {
  DAPLACE
  PROPIETARIO
  OTRO
}

enum EstadoEvidenciaPago {
  REFERENCIADA
  VALIDADA
  RECHAZADA
}

enum EstadoFirmaContrato {
  REFERENCIADA
  VALIDADA
  RECHAZADA
}

enum ConceptoPago {
  ADELANTO
  SALDO
  PAGO_TOTAL
  PENALIDAD
  OTRO
}

enum MetodoPago {
  TRANSFERENCIA
  TARJETA
  EFECTIVO
  BILLETERA_DIGITAL
  DEPOSITO
  OTRO
}

enum EstadoGarantia {
  EN_CUSTODIA
  PARCIALMENTE_RETENIDA
  DEVUELTA_TOTAL
  RETENIDA_TOTAL
  LIQUIDADA_MIXTA
}

enum TipoMovimientoGarantia {
  RECEPCION
  RETENCION
  DEVOLUCION_PARCIAL
  DEVOLUCION_TOTAL
}

enum EstadoGasto {
  REGISTRADO
  APROBADO
  ANULADO
}

model Usuario {
  id                  String               @id @default(uuid())
  nombre              String
  email               String               @unique
  telefono            String?
  rol                 RolUsuario           @default(PROPIETARIO)
  activo              Boolean              @default(true)
  creadoEn            DateTime             @default(now())
  actualizadoEn       DateTime             @updatedAt

  propiedades         Propiedad[]
  pagosRegistrados    Pago[]               @relation("PagosRegistrados")
  pagosConciliados    Pago[]               @relation("PagosConciliados")
  movimientosGarantia MovimientoGarantia[]
  gastosRegistrados   Gasto[]              @relation("GastosRegistrados")
  gastosAprobados     Gasto[]              @relation("GastosAprobados")
  gastosAnulados      Gasto[]              @relation("GastosAnulados")
  sustentosRegistrados SustentoGasto[]     @relation("SustentosRegistrados")
  evidenciasPagoRegistradas EvidenciaPago[] @relation("EvidenciasPagoRegistradas")
  contratosRegistrados ContratoReserva[]    @relation("ContratosRegistrados")
  contratosValidados   ContratoReserva[]    @relation("ContratosValidados")
  trabajosAsignados    OrdenTrabajo[]       @relation("TrabajosAsignados")
  trabajosCreados      OrdenTrabajo[]       @relation("TrabajosCreados")
  user                 User?

  @@map("usuarios")
}

model Propiedad {
  id                 String            @id @default(uuid())
  nombre             String
  propietarioId      String
  direccion          String
  estadoOperativo    EstadoOperativo   @default(OPERATIVA)
  estadoPublicacion  EstadoPublicacion @default(BORRADOR)
  activa             Boolean           @default(true)
  capacidadHuespedes Int               @default(2)
  precioBaseNoche    Decimal           @default(200.00) @db.Decimal(10, 2)
  moneda             String            @default("PEN")
  creadoEn           DateTime          @default(now())
  actualizadoEn      DateTime          @updatedAt

  propietario        Usuario           @relation(fields: [propietarioId], references: [id], onDelete: Restrict)
  reservas           Reserva[]
  gastos             Gasto[]
  ordenesTrabajo     OrdenTrabajo[]

  @@index([propietarioId])
  @@index([estadoOperativo, activa])
  @@map("propiedades")
}

model Huesped {
  id              String         @id @default(uuid())
  nombreCompleto  String
  telefono        String?
  email           String?
  tipoDocumento   TipoDocumento?
  numeroDocumento String?
  nacionalidad    String?
  notas           String?
  creadoEn        DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt

  reservas        Reserva[]

  @@index([email])
  @@index([telefono])
  @@index([numeroDocumento])
  @@map("huespedes")
}

model Reserva {
  id                String        @id @default(uuid())
  propiedadId       String
  huespedId         String
  ingreso           DateTime      @db.Date
  salida            DateTime      @db.Date
  noches            Int
  estado            EstadoReserva @default(SOLICITADA)
  montoAcordado     Decimal       @db.Decimal(10, 2)
  moneda            String        @default("PEN")
  origen            OrigenReserva @default(WEB)
  referenciaCanal   String?
  notas             String?
  motivoCancelacion     String?
  plazoIniciadoEn       DateTime?     @db.Timestamptz(3)
  venceEn               DateTime?     @db.Timestamptz(3)
  politicaPlazoVersion  String?
  politicaPlazoSnapshot Json?
  avisoProgramadoEn     DateTime?     @db.Timestamptz(3)
  expiradaEn            DateTime?     @db.Timestamptz(3)
  creadaEn              DateTime      @default(now())
  actualizadaEn         DateTime      @updatedAt

  propiedad             Propiedad     @relation(fields: [propiedadId], references: [id], onDelete: Restrict)
  huesped               Huesped       @relation(fields: [huespedId], references: [id], onDelete: Restrict)
  pagos                 Pago[]
  garantia              Garantia?
  contratos             ContratoReserva[]
  avisos                AvisoReserva[]
  ordenesTrabajo        OrdenTrabajo[]

  @@index([propiedadId, ingreso, salida])
  @@index([huespedId])
  @@index([estado])
  @@index([venceEn])
  @@index([estado, venceEn])
  @@index([avisoProgramadoEn])
  @@map("reservas")
}

model Pago {
  id                  String       @id @default(uuid())
  reservaId           String
  monto               Decimal      @db.Decimal(12, 2)
  moneda              String       @default("PEN")
  concepto            ConceptoPago @default(ADELANTO)
  metodoPago          MetodoPago   @default(TRANSFERENCIA)
  referenciaOperacion String
  fechaPago           DateTime     @db.Date
  estado              EstadoPago   @default(PENDIENTE_CONCILIACION)
  idempotencyKey      String?      @unique
  payloadHash         String?
  registradoPorId     String?
  creadoEn            DateTime     @default(now())
  conciliadoPorId     String?
  conciliadoEn        DateTime?
  motivoRechazo       String?
  rechazadoEn         DateTime?
  notas               String?
  beneficiarioTipo    BeneficiarioPago?
  beneficiarioNombre  String?
  bancoReceptor       String?
  cuentaReferencia    String?

  reserva             Reserva         @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  registradoPor       Usuario?        @relation("PagosRegistrados", fields: [registradoPorId], references: [id], onDelete: SetNull)
  conciliadoPor       Usuario?        @relation("PagosConciliados", fields: [conciliadoPorId], references: [id], onDelete: SetNull)
  evidencias          EvidenciaPago[]

  @@index([reservaId])
  @@index([estado])
  @@index([fechaPago])
  @@index([referenciaOperacion])
  @@map("pagos")
}

model Garantia {
  id             String         @id @default(uuid())
  reservaId      String         @unique
  moneda         String         @default("PEN")
  montoTotal     Decimal        @db.Decimal(12, 2)
  estado         EstadoGarantia @default(EN_CUSTODIA)
  creadaEn       DateTime       @default(now())
  actualizadaEn  DateTime       @updatedAt

  reserva        Reserva        @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  movimientos    MovimientoGarantia[]

  @@index([estado])
  @@map("garantias")
}

model MovimientoGarantia {
  id               String                 @id @default(uuid())
  garantiaId       String
  tipo             TipoMovimientoGarantia
  monto            Decimal                @db.Decimal(12, 2)
  motivo           String
  documentoSoporte String?
  actorId          String?
  idempotencyKey   String?                @unique
  creadoEn         DateTime               @default(now())

  garantia         Garantia               @relation(fields: [garantiaId], references: [id], onDelete: Restrict)
  actor            Usuario?               @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([garantiaId])
  @@index([tipo])
  @@index([creadoEn])
  @@map("movimientos_garantia")
}

model AuditoriaEvento {
  id         String   @id @default(uuid())
  entidad    String
  entidadId  String
  accion     String
  actor      String   @default("SYSTEM_DEV")
  motivo     String?
  detalles   Json?
  requestId  String?
  creadoEn   DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([creadoEn])
  @@map("auditoria_eventos")
}

model Gasto {
  id              String          @id @default(uuid())
  propiedadId     String
  fechaGasto      DateTime        @db.Date
  periodoMes      Int
  periodoAnio     Int
  titulo          String
  categoria       String
  notas           String?
  monto           Decimal         @db.Decimal(12, 2)
  moneda          String          @default("PEN")
  pagadoPor       String
  repartido       String?
  usoRucDaplace   Boolean?
  estado          EstadoGasto     @default(REGISTRADO)
  idempotencyKey  String?         @unique
  payloadHash     String?

  registradoPorId String?
  aprobadoPorId   String?
  aprobadoEn      DateTime?
  anuladoPorId    String?
  anuladoEn       DateTime?
  motivoAnulacion String?

  creadoEn        DateTime        @default(now())
  actualizadoEn   DateTime        @updatedAt

  propiedad       Propiedad       @relation(fields: [propiedadId], references: [id], onDelete: Restrict)
  registradoPor   Usuario?        @relation("GastosRegistrados", fields: [registradoPorId], references: [id], onDelete: SetNull)
  aprobadoPor     Usuario?        @relation("GastosAprobados", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  anuladoPor      Usuario?        @relation("GastosAnulados", fields: [anuladoPorId], references: [id], onDelete: SetNull)
  sustentos       SustentoGasto[]

  @@index([propiedadId])
  @@index([fechaGasto])
  @@index([periodoAnio, periodoMes])
  @@index([categoria])
  @@index([estado])
  @@map("gastos")
}

model SustentoGasto {
  id              String   @id @default(uuid())
  gastoId         String
  tipo            String   @default("COMPROBANTE")
  nombreArchivo   String
  url             String
  origen          String?  @default("MANUAL")
  registradoPorId String?
  creadoEn        DateTime @default(now())

  gasto           Gasto    @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  registradoPor   Usuario? @relation("SustentosRegistrados", fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([gastoId])
  @@map("sustentos_gasto")
}

model EvidenciaPago {
  id                   String              @id @default(uuid())
  pagoId               String
  tipo                 String              @default("VOUCHER")
  nombreArchivo        String
  referenciaDocumental String?
  url                  String?
  estado               EstadoEvidenciaPago @default(REFERENCIADA)
  notas                String?
  idempotencyKey       String?
  payloadHash          String?
  registradoPorId      String?
  creadoEn             DateTime            @default(now())

  pago                 Pago                @relation(fields: [pagoId], references: [id], onDelete: Restrict)
  registradoPor        Usuario?            @relation("EvidenciasPagoRegistradas", fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@unique([pagoId, idempotencyKey])
  @@index([pagoId])
  @@index([estado])
  @@map("evidencias_pago")
}

model ContratoReserva {
  id                  String              @id @default(uuid())
  reservaId           String
  version             Int
  nombreOriginal      String
  urlReferencia       String?
  estadoFirma         EstadoFirmaContrato @default(REFERENCIADA)
  registradoPorId     String
  registradoEn        DateTime            @default(now())
  validadoPorId       String?
  validadoEn          DateTime?
  motivoValidacion    String?
  reemplazaContratoId String?
  idempotencyKey      String?
  payloadHash         String?

  reserva             Reserva             @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  registradoPor       Usuario             @relation("ContratosRegistrados", fields: [registradoPorId], references: [id], onDelete: Restrict)
  validadoPor         Usuario?            @relation("ContratosValidados", fields: [validadoPorId], references: [id], onDelete: SetNull)
  reemplazaContrato   ContratoReserva?    @relation("ContratoReemplazado", fields: [reemplazaContratoId], references: [id], onDelete: SetNull)
  contratosSustitutos ContratoReserva[]   @relation("ContratoReemplazado")

  @@unique([reservaId, version])
  @@unique([reservaId, idempotencyKey])
  @@index([reservaId])
  @@index([estadoFirma])
  @@map("contratos_reserva")
}

enum TipoAvisoReserva {
  EXPIRACION_PROXIMA
  SOLICITUD_EXPIRADA
}

enum EstadoAvisoReserva {
  PROGRAMADO
  PENDIENTE
  EN_ENVIO
  ENVIADO
  FALLIDO
  CANCELADO
}

enum CanalAvisoReserva {
  EMAIL
  WHATSAPP
  SISTEMA
}

model AvisoReserva {
  id                 String             @id @default(uuid())
  reservaId          String
  tipoAviso          TipoAvisoReserva
  politicaVersion    String
  venceEnSnapshot    DateTime           @db.Timestamptz(3)
  programadoPara     DateTime           @db.Timestamptz(3)
  canal              CanalAvisoReserva
  plantilla          String
  estado             EstadoAvisoReserva @default(PROGRAMADO)
  reintentos         Int                @default(0)
  maxReintentos      Int                @default(3)
  leaseToken         String?
  leaseVenceEn       DateTime?          @db.Timestamptz(3)
  enviadoEn          DateTime?          @db.Timestamptz(3)
  canceladoEn        DateTime?          @db.Timestamptz(3)
  motivoCancelacion  String?
  proveedorId        String?
  ultimoErrorCodigo  String?
  ultimoErrorMensaje String?
  idempotencyKey     String?
  proximoIntentoEn   DateTime?          @db.Timestamptz(3)
  creadoEn           DateTime           @default(now()) @db.Timestamptz(3)
  actualizadoEn      DateTime           @updatedAt @db.Timestamptz(3)

  reserva            Reserva            @relation(fields: [reservaId], references: [id], onDelete: Restrict)

  @@unique([reservaId, tipoAviso, politicaVersion, venceEnSnapshot], name: "aviso_reserva_logica_unica")
  @@index([reservaId])
  @@index([estado, programadoPara])
  @@index([estado, proximoIntentoEn])
  @@index([leaseToken, leaseVenceEn])
  @@map("avisos_reserva")
}

enum UserRole {
  ADMINISTRADOR
  OPERADOR
  PROPIETARIO
  CLIENTE
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  nombre       String
  cargo        String?
  rol          UserRole      @default(CLIENTE)
  isActive     Boolean       @default(true)
  usuarioId    String?       @unique
  usuario      Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]

  @@map("users")
}

model AuthSession {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  family              String    @default(uuid())
  revokedAt           DateTime?
  replacedByTokenHash String?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  userAgent           String?
  ipAddress           String?

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
  @@map("auth_sessions")
}

enum TipoTrabajoMantenimiento {
  LIMPIEZA
  REPARACION
  INSPECCION
  PINTURA
  OTRO
}

enum PrioridadTrabajo {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum EstadoOrdenTrabajo {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

model OrdenTrabajo {
  id               String                   @id @default(uuid())
  propiedadId      String
  reservaId        String?
  titulo           String
  descripcion      String
  tipo             TipoTrabajoMantenimiento @default(INSPECCION)
  prioridad        PrioridadTrabajo         @default(MEDIA)
  estado           EstadoOrdenTrabajo       @default(PENDIENTE)
  asignadoAId      String?
  costoEstimado    Decimal?                 @db.Decimal(10, 2)
  costoReal        Decimal?                 @db.Decimal(10, 2)
  notasResolucion  String?
  creadoPorId      String
  creadoEn         DateTime                 @default(now())
  actualizadoEn    DateTime                 @updatedAt
  completadoEn     DateTime?

  propiedad        Propiedad                @relation(fields: [propiedadId], references: [id], onDelete: Restrict)
  reserva          Reserva?                 @relation(fields: [reservaId], references: [id], onDelete: SetNull)
  asignadoA        Usuario?                 @relation("TrabajosAsignados", fields: [asignadoAId], references: [id], onDelete: SetNull)
  creadoPor        Usuario                  @relation("TrabajosCreados", fields: [creadoPorId], references: [id], onDelete: Restrict)

  @@index([propiedadId])
  @@index([reservaId])
  @@index([asignadoAId])
  @@index([estado])
  @@map("ordenes_trabajo")
}
