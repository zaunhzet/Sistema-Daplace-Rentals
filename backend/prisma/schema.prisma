generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRADOR
  OPERADOR
  PROPIETARIO
  CLIENTE
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  nombre       String
  cargo        String?
  rol          UserRole      @default(CLIENTE)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]

  @@map("users")
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  family    String    @default(uuid())
  revokedAt           DateTime?
  replacedByTokenHash String?
  expiresAt           DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
  @@map("auth_sessions")
}

